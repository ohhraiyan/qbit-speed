{
  "id": "qbittorrent-speeds",
  "name": "qBittorrent Speeds",
  "version": "1.0.0",
  "minNoctaliaVersion": "3.6.0",
  "author": "you",
  "license": "MIT",
  "repository": "https://github.com/yourusername/noctalia-plugins",
  "description": "Shows live download/upload speeds from one or more qBittorrent instances",
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "instances": [
        {
          "name": "Local",
          "host": "http://localhost:8080",
          "username": "admin",
          "password": ""
        }
      ],
      "refreshInterval": 3,
      "showUpload": true,
      "showDownload": true,
      "showInstanceName": false
    }
  }
}
